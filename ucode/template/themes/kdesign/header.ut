{%
	import { getuid, getspnam } from 'luci.core';
	import { cursor } from 'uci';
	const boardinfo = ubus.call('system', 'board') ?? {};
	const page_title = dispatched?.title ? _(dispatched.title) : _('Overview');
	const kdesign_uci = cursor();
	const configured_brand_name = kdesign_uci.get_first('kdesign', 'theme', 'brand_name');
	const configured_brand_subtitle = kdesign_uci.get_first('kdesign', 'theme', 'brand_subtitle');
	const kdesign_brand_name = striptags(configured_brand_name || 'KDesign');
	const kdesign_brand_subtitle = striptags(configured_brand_subtitle || boardinfo.hostname || '?');
	const kdesign_brand_logo = striptags(kdesign_uci.get_first('kdesign', 'theme', 'brand_logo') || `${media}/logo.svg`);
	const kdesign_login_background = striptags(kdesign_uci.get_first('kdesign', 'theme', 'login_background') || '');
	const kdesign_login_background_color = striptags(kdesign_uci.get_first('kdesign', 'theme', 'login_background_color') || '');
	const kdesign_login_overlay = striptags(kdesign_uci.get_first('kdesign', 'theme', 'login_overlay') || '0');
	const kdesign_sidebar_default = kdesign_uci.get_first('kdesign', 'theme', 'sidebar_collapsed') == '1';
	http.prepare_content('text/html; charset=UTF-8');
-%}
<!DOCTYPE html>
<html lang="{{ dispatcher.lang }}" data-theme="light" data-theme-preference="system" data-sidebar-default="{{ kdesign_sidebar_default ? 'true' : 'false' }}">
	<head>
		<meta charset="utf-8">
		<title>{{ striptags(`${page_title} | ${boardinfo.hostname ?? '?'} | LuCI`) }}</title>
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<meta name="darkreader-lock">
		<script src="{{ media }}/theme.js"></script>
		<link rel="stylesheet" href="{{ media }}/cascade.css">
		<link rel="icon" href="{{ media }}/logo.svg" sizes="any" type="image/svg+xml">
		{% if (dispatched?.css): %}<link rel="stylesheet" href="{{ resource }}/{{ dispatched.css }}">{% endif %}
		{% if (css): %}<style title="text/css">{{ css }}</style>{% endif %}
		<script src="{{ dispatcher.build_url('admin/translations', dispatcher.lang) }}"></script>
		<script src="{{ resource }}/cbi.js"></script>
	</head>
	<body class="lang_{{ dispatcher.lang }}{{ blank_page ? ' kdesign-login-body' : '' }}" data-page="{{ entityencode(join('-', length(ctx.request_path) ? ctx.request_path : ctx.path), true) }}" data-media="{{ media }}" data-login-background="{{ entityencode(kdesign_login_background, true) }}" data-login-background-color="{{ entityencode(kdesign_login_background_color, true) }}" data-login-overlay="{{ entityencode(kdesign_login_overlay, true) }}">
		{% if (!blank_page): %}
		<div class="kdesign-shell">
			<aside class="kdesign-sidebar" aria-label="{{ _('Main navigation') }}">
				<a class="kdesign-brand" href="{{ dispatcher.build_url('admin') }}">
					<img class="kdesign-brand-mark" src="{{ entityencode(kdesign_brand_logo, true) }}" alt="">
					<span class="kdesign-brand-copy"><span class="kdesign-brand-name">{{ kdesign_brand_name }}</span><span class="kdesign-brand-host">{{ kdesign_brand_subtitle }}</span></span>
				</a>
				<nav class="kdesign-sidebar-nav" aria-label="{{ _('Configuration') }}"><ul id="topmenu" style="display:none"></ul></nav>
				<div class="kdesign-sidebar-footer">
					<ul class="kdesign-mode-menu" id="modemenu" style="display:none"></ul>
					<button class="kdesign-sidebar-action kdesign-sidebar-collapse" type="button" data-kdesign-sidebar-collapse data-label-collapse="折叠侧边栏" data-label-expand="展开侧边栏">
						<img src="{{ media }}/icons/panel-left-close.svg" alt=""><span>折叠侧边栏</span>
					</button>
					<button class="kdesign-sidebar-action" type="button" data-kdesign-appearance data-label-system="{{ _('Follow system') }}" data-label-light="{{ _('Light mode') }}" data-label-dark="{{ _('Dark mode') }}">
						<img src="{{ media }}/icons/monitor.svg" alt=""><span data-kdesign-appearance-label>{{ _('Follow system') }}</span>
					</button>
					<a class="kdesign-sidebar-action kdesign-sidebar-logout" href="{{ dispatcher.build_url('admin/logout') }}"><img src="{{ media }}/icons/log-out.svg" alt=""><span>{{ _('Log out') }}</span></a>
				</div>
			</aside>
			<button class="kdesign-sidebar-overlay" type="button" data-kdesign-sidebar-overlay hidden aria-label="{{ _('Close navigation') }}"></button>
			<div class="kdesign-workspace">
				<header class="kdesign-page-header">
					<button class="kdesign-menu-toggle" type="button" data-kdesign-menu-toggle aria-expanded="false" aria-label="{{ _('Open navigation') }}"><img src="{{ media }}/icons/menu.svg" alt=""></button>
					<div class="kdesign-page-heading"><p class="kdesign-breadcrumb">LuCI / {{ striptags(boardinfo.hostname ?? '?') }}</p><h1 class="kdesign-page-title">{{ striptags(page_title) }}</h1></div>
					<div id="indicators"></div>
				</header>
				<main id="maincontent" class="kdesign-main kdesign-content">
					{% if (getuid() == 0 && getspnam('root')?.pwdp === ''): %}
					<div class="alert-message warning"><h4>{{ _('No password set!') }}</h4><p>{{ _('There is no password set on this router. Please configure a root password to protect the web interface.') }}</p>
						{% if (dispatcher.lookup('admin/system/admin')): %}<div class="right"><a class="btn" href="{{ dispatcher.build_url('admin/system/admin') }}">{{ _('Go to password configuration...') }}</a></div>{% endif %}
					</div>
					{% endif %}
					{% if (boardinfo.rootfs_type == 'initramfs'): %}
					<div class="alert-message warning"><h4>{{ _('System running in recovery (initramfs) mode.') }}</h4><p>{{ _('No changes to settings will be stored and are lost after rebooting. This mode should only be used to install a firmware upgrade') }}</p>
						{% if (dispatcher.lookup('admin/system/flash')): %}<div class="right"><a class="btn" href="{{ dispatcher.build_url('admin/system/flash') }}">{{ _('Go to firmware upgrade...') }}</a></div>{% endif %}
					</div>
					{% endif %}
					<noscript><div class="alert-message warning"><h4>{{ _('JavaScript required!') }}</h4><p>{{ _('You must enable JavaScript in your browser or LuCI will not work properly.') }}</p></div></noscript>
					<div id="tabmenu" style="display:none"></div>
		{% endif %}
